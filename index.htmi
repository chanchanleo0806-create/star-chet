index.htmi
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>STAR CHAT - 보안 100방</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { background: #202225; color: #fff; font-family: sans-serif; margin: 0; display: flex; justify-content: center; align-items: center; height: 100vh; }
        #login-box, #chat-box-wrapper { background: #2f3136; padding: 30px; border-radius: 10px; width: 300px; text-align: center; }
        #chat-box-wrapper { width: 90%; max-width: 500px; height: 80vh; display: none; flex-direction: column; }
        input { width: 80%; padding: 10px; margin: 10px 0; border-radius: 5px; border: none; background: #40444b; color: #fff; }
        button { width: 85%; padding: 10px; background: #5865f2; color: #fff; border: none; borderRadius: 5px; cursor: pointer; font-weight: bold; }
        #messages { flex: 1; overflow-y: auto; text-align: left; padding: 10px; background: #36393f; margin-bottom: 10px; border-radius: 5px; }
        .msg { background: #40444b; padding: 8px; border-radius: 5px; margin-bottom: 8px; font-size: 14px; }
        .time { font-size: 10px; color: #888; display: block; }
    </style>
</head>
<body>

    <div id="login-box">
        <h2>🔐 STAR CHAT</h2>
        <input type="number" id="roomNum" placeholder="방 번호 (1-100)">
        <input type="password" id="roomPw" placeholder="비밀번호">
        <button onclick="joinRoom()">접속 / 생성</button>
    </div>

    <div id="chat-box-wrapper">
        <h3 id="room-title">방 접속 중</h3>
        <div id="messages"></div>
        <div style="display:flex; gap:5px;">
            <input type="text" id="msgInput" placeholder="메시지..." style="flex:1">
            <button onclick="sendMsg()" style="width:60px">전송</button>
        </div>
        <button onclick="location.reload()" style="margin-top:10px; background:#f04747">나가기</button>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getDatabase, ref, set, get, push, onValue } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

        const firebaseConfig = {
            apiKey: "AIzaSyAcBQ_Pyt4kdExDLGyNZJwWGbCdGDzVIjQ",
            authDomain: "starchet-e9630.firebaseapp.com",
            databaseURL: "https://starchet-e9630-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "starchet-e9630",
            storageBucket: "starchet-e9630.firebasestorage.app",
            messagingSenderId: "532571302538",
            appId: "1:532571302538:web:73ad808e560947ea02db73"
        };

        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);

        let currentRoom = "";

        window.joinRoom = async () => {
            const room = document.getElementById('roomNum').value;
            const pw = document.getElementById('roomPw').value;

            if (room < 1 || room > 100) return alert("1~100번 방만 가능!");
            if (!pw) return alert("비번 입력!");

            const roomRef = ref(db, `rooms/${room}`);
            const snap = await get(roomRef);

            if (snap.exists()) {
                if (snap.val().password !== pw) return alert("비번 틀림!");
            } else {
                await set(roomRef, { password: pw });
                alert(room + "번 방이 새로 생겼습니다!");
            }

            currentRoom = room;
            document.getElementById('login-box').style.display = 'none';
            document.getElementById('chat-box-wrapper').style.display = 'flex';
            document.getElementById('room-title').innerText = "📡 " + room + "번 방";
            listenChat();
        };

        function listenChat() {
            onValue(ref(db, `chats/${currentRoom}`), (snap) => {
                const msgDiv = document.getElementById('messages');
                msgDiv.innerHTML = "";
                const data = snap.val();
                if (data) {
                    Object.values(data).forEach(m => {
                        msgDiv.innerHTML += `<div class="msg"><span class="time">${m.time}</span>${m.text}</div>`;
                    });
                    msgDiv.scrollTop = msgDiv.scrollHeight;
                }
            });
        }

        window.sendMsg = () => {
            const input = document.getElementById('msgInput');
            if (!input.value) return;
            push(ref(db, `chats/${currentRoom}`), {
                text: input.value,
                time: new Date().toLocaleTimeString()
            });
            input.value = "";
        };
    </script>
</body>
</html>